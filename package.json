{
  "name": "rollinit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx --watch --watch-path=server.ts --watch-path=src/lib server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "eslint",
    "db:migrate": "npx prisma migrate dev",
